{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Saecula Kartbordet",
  "version": "1.0.0",
  "identifier": "se.criteroconsulting.kartbordet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8240",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Saecula: Kartbordet",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.board-games",
    "copyright": "© 2026 Pär Levander. Bygger på Marble & Mayhem av Anders Bjarby.",
    "shortDescription": "Schack vid Saeculas kartbord",
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.3"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
